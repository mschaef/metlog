{:log-path "./metlog.log"
 :development-mode true
 :db {:subname "./local-db/metlog"}
 :vault {:http-port 8080}
 :agent {:name "local"
         :vault-url "http://localhost:8080"
         :sensor-file "./sensor.clj"}

 :job-schedule {:data-archiver "*/5 * * * *"
                :defragment-database "*/15 * * * *"}}
