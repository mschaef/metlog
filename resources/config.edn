{:app {:name "Metlog"}
 :log-path "/var/log/metlog/metlog.log"
 :development-mode false
 :mode #{:vault :agent}

 :vault {:http-port 8080
         :http-thread-count 8
         :hot-storage-days 180
         :store-sample-batch-size 200
         ;; Keep the pool smaller than http-thread-count. Requests that
         ;; wait on the database (e.g. behind a long archiver transaction
         ;; or a defrag) can then tie up at most pool-size HTTP threads;
         ;; the rest stay free for requests that don't use the database
         ;; (static resources, agent ingest), and requests beyond the
         ;; pool fail after connection-timeout-sec rather than hanging.
         :db {:pool-size 6
              :connection-timeout-sec 5}
         ;; The archiver moves samples to cold storage in transactions
         ;; covering at most this much time per series, so it never
         ;; holds locks on the sample table for long.
         :archive-chunk-hours 24}

 :agent {:name "default"
         :vault-url "http://metrics.mschaef.com"
         :vault-update-size-limit 200
         :vault-update-interval-sec 60
         :vault-healthcheck-interval-sec 60
         :vault-connection-timeout-sec 15
         :vault-socket-timeout-sec 30
         :sensor-file "/etc/metlog/config.clj"}

 :job-schedule {:data-archiver "0 22 * * *"
                :defragment-database "0 23 * * *"
                :sample-ingress-queue "*/1 * * * *"
                :sample-jvm-stats "0 * * * *"
                :store-ingress-queue "*/1 * * * *"
                :agent-vault-update "*/1 * * * *"}}
